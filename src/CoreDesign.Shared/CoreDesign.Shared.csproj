<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackageId>CoreDesign.Shared</PackageId>
        <VersionPrefix>11.0.1</VersionPrefix>
        <Description>Shared infrastructure, error result types, and utility extension methods for .NET projects. Intended to be referenced by both host/API projects and AppHost projects.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/codyskidmore/CoreDesign/tree/main/src/CoreDesign.Shared</PackageProjectUrl>
        <RepositoryUrl>https://github.com/codyskidmore/CoreDesign</RepositoryUrl>
        <PackageTags>aspire;configuration;extensions;coredesign</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.AppHost" Version="13.6.5" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0" />
        <PackageReference Include="MessagePack" Version="3.1.12" />
        <PackageReference Include="Ulid" Version="1.4.1" />
    </ItemGroup>

</Project>

