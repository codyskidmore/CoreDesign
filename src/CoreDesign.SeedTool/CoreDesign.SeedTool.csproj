<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>default</LangVersion>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>dotnet-seed</ToolCommandName>
        <PackageId>CoreDesign.SeedTool</PackageId>
        <Version>1.0.2</Version>
        <Description>CLI tool for exporting CoreDesign.Data entity data to MigrationWorker-compatible seed files and comparing seed files to a live database.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/codyskidmore/CoreDesign/tree/main/src/CoreDesign.SeedTool</PackageProjectUrl>
        <RepositoryUrl>https://github.com/codyskidmore/CoreDesign</RepositoryUrl>
        <PackageTags>efcore;seeding;data;coredesign;tool</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <ProjectReference Include="..\CoreDesign.Data\CoreDesign.Data.csproj" />
    </ItemGroup>


</Project>
