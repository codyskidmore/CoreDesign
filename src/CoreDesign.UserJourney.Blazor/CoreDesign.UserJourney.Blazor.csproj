<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <PackageId>CoreDesign.UserJourney.Blazor</PackageId>
        <VersionPrefix>11.0.1</VersionPrefix>
        <Description>Blazor Server support for CoreDesign.UserJourney. Links Blazor clicks and in-app navigation, which travel over the SignalR circuit instead of HTTP, to the signed-in user, and adds a JourneyView component for recording which item a page showed.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/codyskidmore/CoreDesign/tree/main/src/CoreDesign.UserJourney.Blazor</PackageProjectUrl>
        <RepositoryUrl>https://github.com/codyskidmore/CoreDesign</RepositoryUrl>
        <PackageTags>user-journey;activity-tracking;blazor;opentelemetry;application-insights;coredesign</PackageTags>
        <PackageReleaseNotes>
11.0.1
- Initial release
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\CoreDesign.UserJourney\CoreDesign.UserJourney.csproj" />
    </ItemGroup>

</Project>
