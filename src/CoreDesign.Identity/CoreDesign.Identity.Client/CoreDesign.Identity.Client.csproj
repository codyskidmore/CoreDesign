<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <PackageId>CoreDesign.Identity.Client</PackageId>
        <Version>1.0.11</Version>
        <Description>ASP.NET Core client library for CoreDesign Identity. Provides bearer token authentication, permission-based authorization, OpenAPI security transformers, and development middleware for consuming a CoreDesign.Identity.Server instance.</Description>
        <PackageTags>identity;authentication;jwt;bearer;aspnetcore;openapi;coredesign</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/codyskidmore/CoreDesign/tree/main/src/CoreDesign.Identity/CoreDesign.Identity.Client</PackageProjectUrl>
        <RepositoryUrl>https://github.com/codyskidmore/CoreDesign</RepositoryUrl>
        <PackageReleaseNotes>Fixed permission policy provider registration. TryAddSingleton was replaced with AddSingleton to ensure PermissionAuthorizationPolicyProvider correctly overrides the DefaultAuthorizationPolicyProvider registered by AddAuthorization.</PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
        <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    </ItemGroup>

</Project>
