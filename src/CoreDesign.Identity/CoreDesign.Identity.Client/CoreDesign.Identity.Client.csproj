<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <PackageId>CoreDesign.Identity.Client</PackageId>
        <Version>1.0.7</Version>
        <Description>ASP.NET Core client library for CoreDesign Identity. Provides bearer token authentication, OpenAPI security transformers, and development middleware for consuming a CoreDesign.Identity.Server instance.</Description>
        <PackageTags>identity;authentication;jwt;bearer;aspnetcore;openapi;coredesign</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/codyskidmore/CoreDesign/tree/main/src/CoreDesign.Identity/CoreDesign.Identity.Client</PackageProjectUrl>
        <RepositoryUrl>https://github.com/codyskidmore/CoreDesign</RepositoryUrl>
        <PackageReleaseNotes>    Added support for frontends authenticating in addiction to using the get-token end point for directly testing APIs.</PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" />
        <None Remove="README.docx" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.8" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
    </ItemGroup>

</Project>
