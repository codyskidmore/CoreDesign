{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "IdentityApi": {
    "BaseUrl": "https://SampleIdentityWeb"
  },
  "CoreDesign": {
    "Identity": {
      "Issuer": "https://localhost:5003",
      "Audience": "https://api.sampleapi.local"
    },
    "IdentityWebHost": {
      "Issuer": "https://localhost:5003",
      "Audience": "https://api.sampleapi.local",
      "TokenLifetimeHours": 8,
      "IdentitiesFilePath": "identities.json",
      "ClientsFilePath": "clients.json"
    }
  },
  "Blazor": {
    "AuthProvider": "Local",
    "Oidc": {
      "ClientId": "sample-blazor",
      "Scopes": [ "openid", "profile", "email", "https://api.sampleapi.local" ]
    }
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<your-tenant-id>",
    "ClientId": "<your-client-id>",
    "CallbackPath": "/signin-oidc"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "DatabaseOptions": {
    "HostName": "sample-mssql",
    "DatabaseName": "sample-db",
    "HostPort": 52881,
    "ConnectionStringName": "sampledb"
  },
  "WeatherForecastCache": {
    "PolicyName": "WeatherForecastPolicy",
    "TagName": "WeatherForecasts",
    "Expiration": 3,
    "QueryKeys": [
      "id"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/sample-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ]
  }
}
