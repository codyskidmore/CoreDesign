@page "/weather"
@attribute [Authorize]
@rendermode InteractiveServer
@inject SampleClient ApiClient
@inject PersistentComponentState ApplicationState

<PageTitle>Weather Forecasts</PageTitle>

<h1>Weather Forecasts</h1>
<p class="text-muted">Data fetched from <strong>Sample.Api</strong> using your OIDC access token.</p>

@if (isLoading)
{
    <p><em>Loading forecasts...</em></p>
}
else if (errorMessage is not null)
{
    <div class="alert alert-danger">
        <strong>Error:</strong> @errorMessage
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Location</th>
                <th>Date</th>
                <th>Temp (C)</th>
                <th>Temp (F)</th>
                <th>Summary</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var forecast in forecasts)
            {
                <tr>
                    <td>@forecast.Location</td>
                    <td>@forecast.Date.ToShortDateString()</td>
                    <td>@forecast.TemperatureC</td>
                    <td>@forecast.TemperatureF</td>
                    <td>@(forecast.Summary ?? "N/A")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private const string ForecastsStateKey = "weather-forecasts";
    private const string ErrorStateKey = "weather-forecasts-error";

    private IReadOnlyList<WeatherForecastResponse> forecasts = [];
    private bool isLoading = true;
    private string? errorMessage;
    private bool hasRestoredState;
    private PersistingComponentStateSubscription? persistingSubscription;

    protected override void OnInitialized()
    {
        persistingSubscription = ApplicationState.RegisterOnPersisting(PersistPageState);

        if (ApplicationState.TryTakeFromJson<List<WeatherForecastResponse>>(ForecastsStateKey, out var restoredForecasts)
            && restoredForecasts is not null)
        {
            forecasts = restoredForecasts;
            hasRestoredState = true;
            isLoading = false;
        }

        if (ApplicationState.TryTakeFromJson<string>(ErrorStateKey, out var restoredError)
            && !string.IsNullOrWhiteSpace(restoredError))
        {
            errorMessage = restoredError;
            hasRestoredState = true;
            isLoading = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (hasRestoredState)
            return;

        try
        {
            forecasts = await ApiClient.GetWeatherForecastsAsync();
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Could not reach Sample.Api: {ex.Message}. " +
                           "Make sure the API is running and the access token has the correct scopes.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task PersistPageState()
    {
        ApplicationState.PersistAsJson(ForecastsStateKey, forecasts);
        ApplicationState.PersistAsJson(ErrorStateKey, errorMessage);
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        persistingSubscription?.Dispose();
    }
}

