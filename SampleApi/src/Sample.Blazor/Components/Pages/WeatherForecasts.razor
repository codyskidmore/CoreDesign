@page "/weather"
@attribute [Authorize]
@rendermode InteractiveServer
@inject SampleApiClient ApiClient

<PageTitle>Weather Forecasts</PageTitle>

<h1>Weather Forecasts</h1>
<p class="text-muted">Data fetched from <strong>SampleApi.Api</strong> using your OIDC access token.</p>

@if (isLoading)
{
    <p><em>Loading forecasts...</em></p>
}
else if (errorMessage is not null)
{
    <div class="alert alert-danger">
        <strong>Error:</strong> @errorMessage
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Location</th>
                <th>Date</th>
                <th>Temp (C)</th>
                <th>Temp (F)</th>
                <th>Summary</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var forecast in forecasts)
            {
                <tr>
                    <td>@forecast.Location</td>
                    <td>@forecast.Date.ToShortDateString()</td>
                    <td>@forecast.TemperatureC</td>
                    <td>@forecast.TemperatureF</td>
                    <td>@(forecast.Summary ?? "N/A")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<WeatherForecastResponse> forecasts = [];
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            forecasts = await ApiClient.GetWeatherForecastsAsync();
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Could not reach SampleApi.Api: {ex.Message}. " +
                           "Make sure the API is running and the access token has the correct scopes.";
        }
        finally
        {
            isLoading = false;
        }
    }
}

